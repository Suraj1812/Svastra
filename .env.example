APP_NAME=SVASTRA+ Authentication MVP
APP_VERSION=1.1.0
DATABASE_URL=sqlite:///./svastra_auth_mvp.db
CONSENT_VERSION=svp-unified-consent-v1
CONSENT_DOCUMENT_PATH=data/svp_unified_consent.md
REFERENCE_TERMS_PATH=data/svp_entry_terms.json
SESSION_TTL_HOURS=24
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
MOCK_OTP=123456
POSTOFFICE_MAX_RETRIES=5
MONITOR_MAX_PAGE_SIZE=100
MONITOR_MAX_WINDOW_DAYS=366
MONITOR_CURSOR_SECRET=replace-with-at-least-32-random-characters
MAX_REQUEST_BYTES=1048576
ATTACHMENT_MAX_BYTES=5242880
ATTACHMENT_STORAGE_PATH=data/private_attachments
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
